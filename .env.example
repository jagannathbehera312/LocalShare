# DropLite Configuration
# Server Port (default: 5000)
PORT=5000

# Server Host (0.0.0.0 binds to all network interfaces for local Wi-Fi sharing)
HOST=0.0.0.0

# Master Admin Password (default is 'droplite123' if not set)
ADMIN_PASSWORD=droplite123

# Session Secret (used to sign session tokens; set to any random string)
SESSION_SECRET=droplite-super-secure-random-token-key-2025

# Max Single Upload Size (e.g. 50GB; chunks allow virtually unlimited file sizes)
MAX_UPLOAD_SIZE_MB=51200

# Optional Storage Quota in MB (0 = unlimited / limited only by disk capacity)
STORAGE_QUOTA_MB=0

# Auto-delete files older than N days (0 = disabled)
AUTO_DELETE_DAYS=0

# Trash Retention Days (files in trash permanently purged after this many days, default 30)
TRASH_RETENTION_DAYS=30

# Blocked File Extensions (comma-separated dangerous executable extensions)
BLOCKED_EXTENSIONS=.exe,.bat,.cmd,.sh,.vbs,.msi,.scr,.com,.ps1,.pif,.application,.gadget
